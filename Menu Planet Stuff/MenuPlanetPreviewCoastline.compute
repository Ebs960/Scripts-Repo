#pragma kernel GenerateCoastline
StructuredBuffer<float> _TopoLandCoastDistance;
StructuredBuffer<float> _TopoOceanCoastDistance;
StructuredBuffer<float> _TopoSignedCoastDistance;
RWTexture2D<float4> _GpuTectonicSurfaceTex;
RWTexture2D<float4> _GpuTectonicBoundaryTex;
RWTexture2D<float4> _GpuTectonicCrustTex;
RWTexture2D<float> _GpuLandMaskTex;
int _MapWidth,_MapHeight,_TopologyWidth,_TopologyHeight; float _Seed,_CoastlineDeformationWidthCells,_CoastlineWarpStrength,_CoastlineMidNoiseStrength,_CoastlineEdgeNoiseStrength,_CoastlineSoftness,_CoastlineThresholdBias;
static const float PI=3.14159265359;
float Hash31(float3 p){p=frac(p*float3(0.1031,0.1030,0.0973)); p+=dot(p,p.yxz+33.33); return frac((p.x+p.y)*p.z);} 
float Noise3D(float3 p){float3 i=floor(p),f=frac(p); f=f*f*(3-2*f); float n000=Hash31(i),n100=Hash31(i+float3(1,0,0)),n010=Hash31(i+float3(0,1,0)),n110=Hash31(i+float3(1,1,0)),n001=Hash31(i+float3(0,0,1)),n101=Hash31(i+float3(1,0,1)),n011=Hash31(i+float3(0,1,1)),n111=Hash31(i+float3(1,1,1)); return lerp(lerp(lerp(n000,n100,f.x),lerp(n010,n110,f.x),f.y),lerp(lerp(n001,n101,f.x),lerp(n011,n111,f.x),f.y),f.z);} 
float Fbm(float3 p){float v=0,a=0.5,f=1;[unroll]for(int i=0;i<4;i++){v+=a*Noise3D(p*f);f*=2;a*=0.5;}return saturate(v);} 
float3 TexelToDir(int x,int y,int w,int h){float2 uv=(float2(x,y)+0.5)/float2(w,h); float lon=uv.x*2*PI-PI; float lat=(0.5-uv.y)*PI; float cl=cos(lat); return normalize(float3(cl*cos(lon),sin(lat),cl*sin(lon)));}
float SampleTopo(StructuredBuffer<float> buf,float2 uv){int x0=(int)floor(uv.x); int y0=(int)floor(uv.y); x0=(x0%_TopologyWidth+_TopologyWidth)%_TopologyWidth; y0=clamp(y0,0,_TopologyHeight-1); int x1=(x0+1)%_TopologyWidth; int y1=min(y0+1,_TopologyHeight-1); float fx=frac(uv.x),fy=frac(uv.y); float v00=buf[y0*_TopologyWidth+x0],v10=buf[y0*_TopologyWidth+x1],v01=buf[y1*_TopologyWidth+x0],v11=buf[y1*_TopologyWidth+x1]; return lerp(lerp(v00,v10,fx),lerp(v01,v11,fx),fy);} 
[numthreads(8,8,1)]
void GenerateCoastline(uint3 id:SV_DispatchThreadID){ if(id.x>=_MapWidth||id.y>=_MapHeight)return; int2 p=int2(id.xy); float2 uv=float2((float)p.x/_MapWidth*_TopologyWidth,(float)p.y/_MapHeight*_TopologyHeight); float inland=SampleTopo(_TopoLandCoastDistance,uv),offshore=SampleTopo(_TopoOceanCoastDistance,uv),signedTopoDistance=SampleTopo(_TopoSignedCoastDistance,uv);
float3 dir=TexelToDir(p.x,p.y,_MapWidth,_MapHeight); float3 seedA=_Seed*float3(0.103,0.071,0.137)+float3(13.7,41.2,5.9); float3 seedB=_Seed*float3(0.067,0.149,0.091)+float3(59.1,11.6,83.4); float3 seedC=_Seed*float3(0.173,0.113,0.047)+float3(27.8,73.5,19.2);
float3 warp=float3(Fbm(dir*1.10+seedA),Fbm(dir*1.10+seedB),Fbm(dir*1.10+seedC))-0.5; float3 warpedDir=normalize(dir+warp*0.40);
float macro=Fbm(warpedDir*1.35+seedA)*2-1, mid=Fbm(warpedDir*2.55+seedB)*2-1, edge=Fbm(dir*4.75+seedC)*2-1;
float signedEnvelope=signedTopoDistance/max(0.001,_CoastlineDeformationWidthCells); float coastInfluence=1-saturate(abs(signedEnvelope)); coastInfluence=coastInfluence*coastInfluence*(3-2*coastInfluence);
float finalCoastSignal=signedEnvelope+(macro*_CoastlineWarpStrength+mid*_CoastlineMidNoiseStrength+edge*_CoastlineEdgeNoiseStrength)*coastInfluence-_CoastlineThresholdBias;
float land=smoothstep(-_CoastlineSoftness,_CoastlineSoftness,finalCoastSignal); float shelf=(1-land)*saturate(1-offshore/(0.04*_MapHeight)); float continentality=land*saturate(inland/(0.24*_MapHeight));
float binaryLand=land>0.5?1.0:0.0; _GpuLandMaskTex[p]=binaryLand; _GpuTectonicSurfaceTex[p]=float4(land,0,0,shelf); _GpuTectonicBoundaryTex[p]=float4(shelf,continentality,0,0); _GpuTectonicCrustTex[p]=float4(continentality,0,0,0); }
