--- !u!114 &11400000
MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 075ae7a4e0c44354e9959697c9e269fc, type: 3}
  m_Name: Appeasement Legacy
  legacyName: Social Compact
  description: 'Every city gains +1 Happiness, and civilization-wide Unrest is reduced by 0.04.'
  flavorText: 'The revolution forced rulers to confront a truth that had been easier to ignore while the streets were quiet: stability cannot rest forever on obedience alone. Concessions made during the crisis gradually hardened into expectations about what government owed the people it governed and what citizens owed in return. Local administration became more attentive to hardship before it became revolt, while ordinary people gained a stronger belief that remaining within the system could still produce change. None of this eliminated disagreement, inequality, or anger. It changed the point at which dissatisfaction became desperation. The state had purchased peace during one crisis and accidentally created institutions that made future peace easier to maintain.'
  policyPointCost: 1
  attackBonus: 0
  defenseBonus: 0
  movementBonus: 0
  attackModifier: 0
  defenseModifier: 0
  foodModifier: 0
  productionModifier: 0
  goldModifier: 0
  scienceModifier: 0
  cultureModifier: 0
  faithModifier: 0
  institutions:
    unrestModifier: -0.04
  unitBonuses: []
  workerBonuses: []
  unitProductionModifiers: []
  improvementBonuses: []
  diseaseBonuses: []
  attritionBonuses: []
  buildingBonuses: []
  cityBonuses:
  - scope: 0
    happinessAdd: 1
  nonStateReligionUnhappinessModifiers: []
