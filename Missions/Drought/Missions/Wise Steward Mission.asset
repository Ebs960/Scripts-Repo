%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Wise Steward Mission
  missionName: Wise Steward
  description: "The land may fail us, but preparation does not have to. Maintain non-negative net Food for 6 consecutive turns and keep consumption within what the civilization can still sustain."
  flavorText: "Plenty tempts a people to believe that tomorrow will resemble today. The empty sky has exposed the danger of that assumption. Grain will be counted carefully, waste reduced, and stores protected from demands that seemed harmless in richer seasons. Stewardship is rarely glorious; no songs are written about the sack of grain that was not eaten too early. Yet when the fields turn brown, foresight becomes its own form of abundance."
  splashImage: {fileID: 21300000, guid: e336ad31b41ac2a40aa742eeefff79f2, type: 3}
  victorySplashImage: {fileID: 21300000, guid: 1f19ba424e7f81148afcd49cc5803fdc, type: 3}
  failureSplashImage: {fileID: 21300000, guid: f8fa7ea3b15e0aa4690b9117c3378d1b, type: 3}
  victoryFlavorText: "Disciplined stewardship carried the civilization through scarcity without systemic collapse. Consumption stayed aligned with supply, reserves were protected, and emergency planning prevented panic drawdowns. What looked like austerity in the moment became resilience in practice. The drought passed without breaking administrative control over food."
  failureFlavorText: "Food management broke down before conditions improved. Overconsumption, leakage, and politically driven exceptions drained reserves faster than they could be stabilized. Once deficits became routine, policy lost credibility and enforcement weakened further. The crisis exposed how quickly scarcity punishes undisciplined governance."
  participantRole: 0
  strategyTags: 34
  objectives:
  - objectiveName: Wise Steward
    description: "Maintain non-negative net Food for 6 consecutive turns."
    type: 28
    targetValue: 6
    targetMode: 0
    targetMultiplier: 1
    minimumTarget: 0
    maximumTarget: 0
  constraints: []
  rewardTiers:
  - tierName: Complete
    requiredObjectivesCompleted: 1
    rewardLegacy: {fileID: 11400000, guid: 17110dfa4c314c4b9df2b3695f452fbb, type: 2}
