MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Adaptable Survivors Mission
  missionName: Adaptable Survivors
  description: "Fields are not the only source of food. Complete {Objective0Target} hunting or foraging actions and turn back to the resources of the wild until ordinary agriculture can sustain us again."
  flavorText: "Our farmers learned to trust the soil because, for generations, the soil rewarded that trust. Now the old skills become valuable again. Hunters will follow migrating animals farther than usual, gatherers will search forgotten places, and foods once ignored will return to the fire. A people that knows only one way to feed itself is always one bad season from disaster. We will survive because we remember more than one."
  participantRole: 0
  strategyTags: 34
  objectives:
  - objectiveName: Adaptable Survivors
    description: "Complete {Objective0Target} hunting or foraging actions."
    type: 42
    targetValue: 2
    targetMode: 1
    targetMultiplier: 0.5
    minimumTarget: 3
    maximumTarget: 8
  constraints: []
  rewardTiers:
  - tierName: Complete
    requiredObjectivesCompleted: 1
    rewardLegacy: {fileID: 11400000, guid: 9b060edb5bf848bd838ebbc6f6c4ba47, type: 2}
