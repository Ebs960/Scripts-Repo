%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Reclaimers Mission
  missionName: Reclaimers
  description: "A captured city is not a lost city while its people still remember who they are. Retake 1 city seized by the invasion and restore it to our civilization."
  flavorText: "The enemy may raise its banners above our walls, but occupation does not make those walls theirs. Roads, homes, temples, graves, and memories bind the captured city to the people driven from it. An army will return along those roads with one purpose: not conquest, but reclamation. Every street retaken tells the invaders that taking territory and keeping it are very different achievements. What was ours will be ours again."
  splashImage: {fileID: 21300000, guid: 3a8122c16fb459c44ac68c412c211ae5, type: 3}
  victorySplashImage: {fileID: 21300000, guid: e6b398f7464decd41917ac8ba591de9c, type: 3}
  failureSplashImage: {fileID: 21300000, guid: 201d1cfbe0a78874492847e680ed3584, type: 3}
  victoryFlavorText: "Our banner flies over the city again, and the occupiers have been driven out. Civilians emerge from hiding to reopen markets, clear rubble, and restore institutions the invaders tried to replace. The reconquest proves to allies and enemies alike that annexation by raid can be reversed. What was taken by force has been returned by force and resolve."
  failureFlavorText: "The occupied city remained beyond our reach for the duration of the crisis. Its garrison held, its collaborators entrenched, and every failed assault deepened the practical reality of enemy control. Refugees now fear that displacement may become permanent. The war continues with one of our own cities still lost."
  participantRole: 0
  strategyTags: 1
  objectives:
  - objectiveName: Reclaimers
    description: "Retake 1 city lost to the invasion."
    type: 25
    targetValue: 1
    targetMode: 0
    targetMultiplier: 1
    minimumTarget: 0
    maximumTarget: 0
  constraints: []
  rewardTiers:
  - tierName: Complete
    requiredObjectivesCompleted: 1
    rewardLegacy: {fileID: 11400000, guid: 535eb53df4984dadb1c3fcb620be1d0e, type: 2}
