  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Oath of the Spear
  m_EditorClassIdentifier: Assembly-CSharp::MissionData
  missionName: Oath of the Spear
  icon: {fileID: 0}
  description: 
  flavorText: 'The great beasts still walk the frozen plains. We will hunt the great
    beasts. We will prove our strength. The cold will learn to fear us. We will feed
    the little ones.


    We swear the Oath of the Spear'
  splashImage: {fileID: 21300000, guid: afe226772073a214894824e1f8251ed3, type: 3}
  victorySplashImage: {fileID: 21300000, guid: ac980255a89e24c4caae6e921317c850, type: 3}
  victoryFlavorText: "The giants fall upon the frozen earth. Their thunderous steps
    no longer shake the plains, and their hides feed and clothe the tribe through
    the endless winter. Hunters return marked by frost and triumph, their names spoken
    with pride. The tribe learns that the world yields to those who face its greatest
    dangers without fear. We are no longer wanderers in the snow. \n\nWe are masters
    of the hunt."
  failureSplashImage: {fileID: 21300000, guid: 1185d29664f499d4398cfbb7640df529, type: 3}
  failureFlavorText: "The great beasts remain beyond our reach. Hunts end in exhaustion,
    injury, and empty hands. Spears break. Hunters fall. The tribe watches the giants
    move across the plains as winter tightens its grip. We endure, but not through
    triumph. \n\nThe world does not always yield to courage."
  earliestTurn: 0
  latestTurn: 0
