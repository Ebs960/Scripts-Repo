%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Rainy Day Fund Mission
  missionName: Rainy Day Fund
  description: "A reserve exists for the moment when ordinary revenue can no longer be trusted. Finish the crisis with at least 100% of the Gold that was held in the treasury when the financial panic began."
  flavorText: "Every ministry now has an emergency. Every commander can explain why funds must be spent immediately, and every struggling institution insists that one more payment will prevent something worse. Yet draining the treasury merely transforms a financial crisis into a fiscal one. The state will spend where survival truly requires it and refuse where panic merely demands reassurance. Reserves accumulated in prosperous years will now justify every sacrifice that created them. When the markets finally settle, there will still be something left in the vault."
  splashImage: {fileID: 21300000, guid: 5d3a244e57579d246ba7df55ef4b1ec3, type: 3}
  victorySplashImage: {fileID: 21300000, guid: 99f0a1ae0cfdece459408256621f6697, type: 3}
  failureSplashImage: {fileID: 21300000, guid: 2ec470d44f590cd429f52b9befd0bc6d, type: 3}
  victoryFlavorText: "The reserve survived the storm. Despite sustained pressure from every sector, the treasury closed the crisis with at least its opening gold intact and preserved strategic flexibility for recovery. Officials can now stabilize institutions without immediate bankruptcy risk. Saving in good years proved its value in bad ones."
  failureFlavorText: "The reserve was exhausted below its required baseline before the panic subsided. Emergency disbursements, revenue collapse, or policy hesitation consumed the buffer faster than controls could compensate. Financial survival in the short term came at the cost of long-term resilience. Recovery now begins with a treasury already depleted."
  participantRole: 0
  strategyTags: 34
  objectives:
  - objectiveName: Rainy Day Fund
    description: "Finish the crisis with at least 100% of the Gold held in your treasury when the crisis began."
    type: 29
    targetValue: 100
    targetMode: 0
    targetMultiplier: 1
    minimumTarget: 0
    maximumTarget: 0
    baselineMetric: 4
    completionTiming: 1
  constraints: []
  rewardTiers:
  - tierName: Complete
    requiredObjectivesCompleted: 1
    rewardLegacy: {fileID: 11400000, guid: b06d43d9567e4376a841c1bd27f2ae5c, type: 2}
