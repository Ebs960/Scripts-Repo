MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8de559a088a5d4d48bb00ae8ccc21165, type: 3}
  m_Name: Cannibal Raids
  crisisName: Cannibal Raids
  ominousWarningText: "People have begun vanishing at the edge of the wild. Tools, baskets, and unfinished work are sometimes found where they were left, but there is rarely any sign of where their owners went. At night, distant fires burn among the hills and forests where no known village or hunting camp should stand. Scouts following unfamiliar tracks have found discarded possessions belonging to the missing, along with signs that strangers have been watching the roads between our settlements."
  obviousWarningText: "The missing have been found—or at least traces of them have. Scouts have discovered a hidden camp beyond our settlements, occupied by armed raiders whose belongings include tools, clothing, and ornaments taken from our people. More fires now appear in the wilderness each night, and watchers report groups moving deliberately toward roads, farms, and isolated homes. These are no wandering strangers looking for food or shelter; they have been studying our settlements and gathering strength. Families are abandoning the outermost dwellings, while hunters sharpen their weapons beside fires that no one allows to die."
  ominousWarningTurns: 1
  obviousWarningTurns: 1
  durationTurns: 15
  useAgeWindow: 1
