MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 075ae7a4e0c44354e9959697c9e269fc, type: 3}
  m_Name: Watchful Settlements
  legacyName: Watchful Settlements
  icon: {fileID: 21300000, guid: 0438d878ec6e7fb4c80fefca2fab67a6, type: 3}
  description: "Every city gains +1 Order."
  flavorText: "The disappearances changed how settlements thought about security. Watch duty stopped being an improvised response to danger and became an ordinary responsibility shared by the community. Approaches were kept visible, strangers noticed, gates watched, and news from neighboring settlements carried quickly enough that one attack could warn everyone else. The original raiders eventually disappeared, but the institutions created to survive them did not. Generations later, a settlement without organized watches seemed as incomplete as one without roads or wells."
