%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Burn the Camps Mission
  missionName: Burn the Camps
  description: "The raids will continue as long as the attackers have safe places from which to gather and strike. Locate and destroy {Objective0Target} raider camps so that they can no longer serve as bases for new attacks."
  flavorText: "A raiding party can be killed and replaced. A camp gives the next band food, shelter, stolen supplies, and a place from which to plan another attack. Scouts will follow the trails beyond our settlements until they lead to the places the raiders believe are hidden. Those camps will be dismantled, burned, or otherwise made useless. Without bases to return to, every surviving attacker will find the wilderness a little less welcoming."
  splashImage: {fileID: 21300000, guid: ad44318fc270fc047b2b2ba22f92a2cc, type: 3}
  victorySplashImage: {fileID: 21300000, guid: b4e3e921747eafc41a48cc01d4066b2f, type: 3}
  failureSplashImage: {fileID: 21300000, guid: 1a480e14df479a94bab75963b48e91c5, type: 3}
  victoryFlavorText: "The camps are gone, reduced to ash and scattered stores. Raider bands that once moved with confidence now wander without supply points, safe fires, or rendezvous routes. Settlement patrols report fewer organized attacks and more signs of flight. We did not merely win skirmishes; we erased the infrastructure of terror."
  failureFlavorText: "Too many camps remained active, and the raiders kept their network intact. Every untouched base sustained another wave of attacks, replacements, and stolen provisions. Frontier families still measure distance by how quickly help can arrive after a horn call. The wilderness remains mapped by enemy fires."
  participantRole: 0
  strategyTags: 1
  objectives:
  - objectiveName: Burn the Camps
    description: "Destroy {Objective0Target} raider camps."
    type: 22
    targetValue: 1
    targetMode: 1
    targetMultiplier: 0.5
    minimumTarget: 2
    maximumTarget: 5
  constraints: []
  rewardTiers:
  - tierName: Complete
    requiredObjectivesCompleted: 1
    rewardLegacy: {fileID: 11400000, guid: 27e6f2682e534f74a1a927b1b5447af3, type: 2}
