%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Crush the Coup Mission
  missionName: Crush the Coup
  description: "The conspirators have abandoned secrecy and taken up arms against the government. Defeat {Objective0Target} units fighting for the coup and break their attempt to turn conspiracy into a new regime."
  flavorText: "There will be no bargaining with officers who believe armed force gives them the right to choose the government. Loyal units are ordered to secure the institutions of state, protect critical positions, and destroy formations that have openly joined the conspiracy. Some commanders will hesitate as friendships, patronage, and old loyalties are tested, but neutrality becomes less possible with every hour. If the conspirators survive long enough, rebellion will begin to resemble authority and obedience may follow appearances. They chose to settle the question by force. The government will answer on the ground they selected."
  splashImage: {fileID: 21300000, guid: be7a6915a8e5370439dcea31d776caaf, type: 3}
  victorySplashImage: {fileID: 21300000, guid: aa644ac0723c10d48ba0e7e337c50fb7, type: 3}
  failureSplashImage: {fileID: 21300000, guid: f8abbd774a0ba8d4398f2652def48850, type: 3}
  victoryFlavorText: "The coup columns have been shattered, and the institutions they tried to seize remain in loyal hands. Rebel commanders are dead, captured, or in flight, and undecided units no longer see an alternative government worth backing. Order is restored at high cost, but restored nonetheless. The lesson is now written in every barracks: armed conspiracy can fail decisively."
  failureFlavorText: "Loyal forces failed to neutralize enough rebel units to break the coup. Strategic sites remain contested, command legitimacy is uncertain, and every hour of unresolved fighting strengthens the perception that power is up for grabs. Neutral officers begin hedging, which accelerates fragmentation. The coup survives because it could not be crushed quickly."
  participantRole: 0
  strategyTags: 129
  objectives:
  - objectiveName: Crush the Coup
    description: "Defeat {Objective0Target} units fighting for the coup."
    type: 21
    targetValue: 1
    targetMode: 4
    targetMultiplier: 0.4
    minimumTarget: 3
    maximumTarget: 10
  constraints: []
  rewardTiers:
  - tierName: Complete
    requiredObjectivesCompleted: 1
    rewardLegacy: {fileID: 11400000, guid: 52b9cd04abb8431091c2ec9e0f8af966, type: 2}
