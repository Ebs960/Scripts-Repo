%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8457553d7570b1146a94bd661e6d7528, type: 3}
  m_Name: Counterplot Mission
  missionName: Counterplot
  description: "The coup depends upon secrecy, coordination, and surprise. Complete the Counterintelligence crisis project before the conspirators can convert preparation into control of the state."
  flavorText: "Armies do not overthrow governments by strength alone. Orders must be transmitted, officers recruited, weapons positioned, communications secured, and sympathetic officials brought into the conspiracy without alerting those who remain loyal. Every intercepted message, compromised courier, and identified organizer tears another hole in that network. Investigators will trace unexplained movements, private commands, and suspicious communications until the conspiracy can no longer tell who knows what. A coup exposed too early loses the advantage on which it depends. Let the conspirators discover that their secret stopped being theirs long before they acted."
  splashImage: {fileID: 21300000, guid: 8fe183bfa9f1f1e4c8d7424a74488a2e, type: 3}
  victorySplashImage: {fileID: 21300000, guid: 5c6463015740e6440a787476f2a84940, type: 3}
  failureSplashImage: {fileID: 21300000, guid: 27f899819bca30a4d8997cd217bf0826, type: 3}
  victoryFlavorText: "Counterintelligence broke the conspiracy before execution day. Safe houses were compromised, covert channels mapped, and would-be coup leaders forced into premature movement that exposed their network. Loyal command regains initiative while plotters scramble under surveillance. The coup fails because secrecy failed first."
  failureFlavorText: "The counterplot effort stalled before decisive exposure. Cells remained compartmentalized, trusted couriers stayed hidden, and enough planning survived to preserve operational surprise. Loyal authorities now know a coup is coming but not where the first blows will land. Forewarning without penetration proved insufficient."
  participantRole: 0
  strategyTags: 20
  objectives:
  - objectiveName: Counterplot
    description: "Complete the Counterintelligence crisis project."
    type: 39
    targetValue: 1
    targetMode: 0
    targetMultiplier: 1
    minimumTarget: 0
    maximumTarget: 0
    specificProject: {fileID: 11400000, guid: 0a020ad790e24ac1a825a63d6f2bb6cc, type: 2}
  constraints: []
  rewardTiers:
  - tierName: Complete
    requiredObjectivesCompleted: 1
    rewardLegacy: {fileID: 11400000, guid: b3476b85595b4b878e0e13acecf59273, type: 2}
