// Minimap generation compute shader
// Takes a LUT (pixel -> tile mapping) and tile color atlas, outputs a minimap texture

#pragma kernel CSMain

// Input: LUT mapping pixel index to tile index (-1 = no tile)
StructuredBuffer<int> _LUT;

// Input: packed 2D texture containing one color per tile
Texture2D<float4> _TileAtlas;

// Output: The generated minimap texture
RWTexture2D<float4> _Result;

// Dimensions
int _Width;
int _Height;
int _TileCount;
int _TileAtlasWidth;

// Grid line overlay (tile borders derived from LUT neighbor differences)
int _DrawGridLines;          // 0/1
int _GridLineWidthPixels;    // 1..N
float4 _GridLineColor;       // RGBA, alpha = blend strength

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // Bounds check
    if (id.x >= (uint)_Width || id.y >= (uint)_Height)
        return;

    // Calculate pixel index (row-major order)
    int pixelIndex = id.y * _Width + id.x;

    // Look up tile index from LUT
    int tileIndex = _LUT[pixelIndex];

    // Default to transparent if no tile.
    // This prevents "streaks/bands" at the texture edges when the LUT contains -1 pixels.
    float4 color = float4(0, 0, 0, 0);

    // If valid tile, sample from atlas
    if (tileIndex >= 0 && tileIndex < _TileCount)
    {
        int atlasX = tileIndex % _TileAtlasWidth;
        int atlasY = tileIndex / _TileAtlasWidth;
        color = _TileAtlas.Load(int3(atlasX, atlasY, 0));
    }

    // Optional gridlines: detect tile borders by comparing LUT neighbor tile indices.
    // This produces crisp borders that match actual tile shapes even after wrapping.
    if (_DrawGridLines == 1 && tileIndex >= 0 && tileIndex < _TileCount)
    {
        int x = (int)id.x;
        int y = (int)id.y;

        // Clamp width to a sane minimum/maximum (avoid accidental huge loops).
        int w = _GridLineWidthPixels;
        if (w < 1) w = 1;
        if (w > 4) w = 4;

        bool isEdge = false;

        // Compare to right/down neighbors within thickness.
        // (We only need one direction; the other side will draw its own edge.)
        [unroll]
        for (int dx = 1; dx <= 4; dx++)
        {
            if (dx > w) break;
            int nx = x + dx;
            if (nx < _Width)
            {
                int nTile = _LUT[y * _Width + nx];
                if (nTile >= 0 && nTile < _TileCount && nTile != tileIndex) { isEdge = true; break; }
            }
        }
        if (!isEdge)
        {
            [unroll]
            for (int dy = 1; dy <= 4; dy++)
            {
                if (dy > w) break;
                int ny = y + dy;
                if (ny < _Height)
                {
                    int nTile = _LUT[ny * _Width + x];
                    if (nTile >= 0 && nTile < _TileCount && nTile != tileIndex) { isEdge = true; break; }
                }
            }
        }

        if (isEdge)
        {
            float a = saturate(_GridLineColor.a);
            float3 adaptiveEdgeColor = lerp(_GridLineColor.rgb, color.rgb * 0.48f, 0.65f);
            color.rgb = lerp(color.rgb, adaptiveEdgeColor, a);
            color.a = max(color.a, a);
        }
    }

    // Write to output
    _Result[id.xy] = color;
}
