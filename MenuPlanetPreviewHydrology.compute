#pragma kernel InitDrainageFill
#pragma kernel RelaxDrainageFill
#pragma kernel BuildFlowDirections
#pragma kernel InitFlowAccumulation
#pragma kernel RelaxFlowAccumulation
#pragma kernel BuildTerrainDrivenHydrologyMasks
#pragma kernel UpsampleAndBeautifyHydrology
#pragma kernel BuildExperimentalBasinCandidates
#pragma kernel SelectExperimentalBasins
#pragma kernel RasterizeExperimentalSelectedBasins
#pragma kernel BuildExperimentalRiverPotential
#pragma kernel ClearExperimentalHydrology
#pragma kernel UpsampleExperimentalBasinHydrology

Texture2D<float4> _TectonicSurfaceTex;
Texture2D<float4> _GpuHeightTex;
RWTexture2D<float4> _GpuHydrologyTex;
RWTexture2D<float4> _GpuHydrologyDepthTex;
RWTexture2D<float4> _DrainageFillTexA;
RWTexture2D<float4> _DrainageFillTexB;
RWTexture2D<float4> _HydroFlowTex;
RWTexture2D<float4> _FlowAccumTexA;
RWTexture2D<float4> _FlowAccumTexB;
RWTexture2D<float4> _CoarseHydrologyMaskTex;
RWTexture2D<float4> _CoarseHydrologyDepthTex;
RWTexture2D<float4> _ExperimentalBasinCandidateTex;
RWTexture2D<float4> _ExperimentalSelectedBasinTex;
RWTexture2D<float4> _ExperimentalRiverPathTex;

int _MapWidth,_MapHeight,_WaterwaysPreset;
int _HydrologyAnalysisWidth,_HydrologyAnalysisHeight;
float _Seed,_Elevation,_Moisture;
float _HydroRoutingJitter,_LakeBasinMinDepth,_LakeBasinFullDepth,_DrainageRiverMinWidthPixels,_DrainageRiverMaxWidthPixels,_LakeShorelineWarpPixels,_RiverAccumulationThreshold,_FlowMinDownhillDelta,_FlowAccumulationCompression;
int _UseExperimentalBasinHydrology,_ExperimentalTargetLakeCount,_ExperimentalRiverAttempts,_ExperimentalMinBasinPixelArea;
float _ExperimentalMinBasinScore,_ExperimentalEffectiveMinBasinScore,_ExperimentalMinBasinSeparationPixels,_ExperimentalWetlandSpread,_ExperimentalRiverMeanderStrength,_ExperimentalRiverValleyBias,_ExperimentalLakeToCoastChance;

float hash1(uint x){x^=x>>17; x*=0xed5ad4bbU; x^=x>>11; x*=0xac4c1b51U; x^=x>>15; x*=0x31848babU; x^=x>>14; return frac((float)x/65535.0);} 
int WrapSignedNoMod(int x, int width){int w=max(1,width); return x - (int)floor((float)x/(float)w)*w;}
int wrapX(int x){return WrapSignedNoMod(x,_MapWidth);}
int2 clampPix(int2 p){return int2(wrapX(p.x), clamp(p.y,0,max(0,_MapHeight-1)));}
float LoadLand(int2 p){return _TectonicSurfaceTex.Load(int3(clampPix(p),0)).x;}
int2 ClampAnalysis(int2 p){ return int2(WrapSignedNoMod(p.x,_HydrologyAnalysisWidth), clamp(p.y,0,_HydrologyAnalysisHeight-1)); }
float GetRawHeight(int2 p){return _GpuHeightTex.Load(int3(clampPix(p),0)).r;}
float GetHydrologyHeight(int2 p)
{
    int2 cp = clampPix(p);
    float center = GetRawHeight(cp);
    float n = GetRawHeight(cp + int2(0, 1));
    float s = GetRawHeight(cp + int2(0, -1));
    float e = GetRawHeight(cp + int2(1, 0));
    float w = GetRawHeight(cp + int2(-1, 0));

    // Center-heavy 5-tap smoothing to suppress single-pixel spikes before routing.
    return center * 0.5 + (n + s + e + w) * 0.125;
}
float CoarseHeight(int2 p){float2 uv=(float2(p)+0.5)/float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight); int2 hp=int2(uv*float2(_MapWidth,_MapHeight)); return GetHydrologyHeight(hp);}
float CoarseLand(int2 p){float2 uv=(float2(p)+0.5)/float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight); int2 hp=int2(uv*float2(_MapWidth,_MapHeight)); return LoadLand(hp);} 

[numthreads(8,8,1)]
void InitDrainageFill(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float land=CoarseLand(p); _DrainageFillTexA[p]=float4(land>0.5?1.0:0.0,0,0,1);} 
[numthreads(8,8,1)]
void RelaxDrainageFill(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float land=CoarseLand(p); if(land<=0.5){_DrainageFillTexB[p]=float4(0,0,0,1); return;} float baseH=CoarseHeight(p); float minN=10; int2 best=p; [unroll] for(int oy=-1;oy<=1;oy++) [unroll] for(int ox=-1;ox<=1;ox++){if(ox==0&&oy==0)continue; int2 np=ClampAnalysis(p+int2(ox,oy)); float n=_DrainageFillTexA[np].r; if(n<minN){minN=n;best=np;}} float nh=max(baseH,minN+0.0002); float2 dir=normalize((float2(best-p))+1e-5); _DrainageFillTexB[p]=float4(nh,dir*0.5+0.5,1);} 
[numthreads(8,8,1)]
void BuildFlowDirections(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float4 f=_DrainageFillTexA[p]; float2 d=f.gb*2-1; d=normalize(d + float2(hash1((uint)(p.x*73856093u+p.y*19349663u))-0.5, hash1((uint)(p.x*83492791u+p.y*1237u))-0.5)*_HydroRoutingJitter); _HydroFlowTex[p]=float4(d*0.5+0.5,saturate(1-f.r),1);} 
[numthreads(8,8,1)]
void InitFlowAccumulation(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float land=CoarseLand(p); float runoff=land*saturate(lerp(0.65,1.35,_Moisture)); _FlowAccumTexA[p]=float4(runoff,runoff,0,1);} 
[numthreads(8,8,1)]
void RelaxFlowAccumulation(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float local=_FlowAccumTexA[p].g; float incoming=0; float h=CoarseHeight(p); [unroll] for(int oy=-1;oy<=1;oy++) [unroll] for(int ox=-1;ox<=1;ox++){ if(ox==0&&oy==0) continue; int2 n=ClampAnalysis(p+int2(ox,oy)); float nh=CoarseHeight(n); if(nh-h<_FlowMinDownhillDelta) continue; float2 nd=_HydroFlowTex[n].rg*2-1; int2 target=ClampAnalysis(n+int2(round(nd))); if(all(target==p)) incoming+=_FlowAccumTexA[n].r; } float newAccum=local + incoming * 0.92; _FlowAccumTexB[p]=float4(newAccum,local,0,1);} 
[numthreads(8,8,1)]
void BuildTerrainDrivenHydrologyMasks(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float land=CoarseLand(p); float h=CoarseHeight(p); float fill=_DrainageFillTexA[p].r; float basin=max(0,fill-h); float accum=_FlowAccumTexA[p].r; float nacc=saturate(1.0-exp(-accum*max(0.001,_FlowAccumulationCompression))); float river=smoothstep(_RiverAccumulationThreshold,_RiverAccumulationThreshold+0.2,nacc)*land; float lake=smoothstep(_LakeBasinMinDepth,_LakeBasinFullDepth,basin)*land; float wet=saturate(max(river,lake)*0.5+nacc*0.22); _CoarseHydrologyMaskTex[p]=float4(river,lake,wet,saturate(max(river,lake))); _CoarseHydrologyDepthTex[p]=float4(river*nacc,lake*saturate(basin*8),nacc,saturate(basin*8));}
[numthreads(8,8,1)]
void UpsampleAndBeautifyHydrology(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_MapWidth||p.y>=_MapHeight) return; float2 uv=(float2(p)+0.5)/float2(_MapWidth,_MapHeight); float2 coarse=uv*float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight)-0.5; int2 base=int2(floor(coarse)); float2 f=frac(coarse); int2 c00=ClampAnalysis(base); int2 c10=ClampAnalysis(base+int2(1,0)); int2 c01=ClampAnalysis(base+int2(0,1)); int2 c11=ClampAnalysis(base+int2(1,1)); float4 m00=_CoarseHydrologyMaskTex[c00],m10=_CoarseHydrologyMaskTex[c10],m01=_CoarseHydrologyMaskTex[c01],m11=_CoarseHydrologyMaskTex[c11]; float4 d00=_CoarseHydrologyDepthTex[c00],d10=_CoarseHydrologyDepthTex[c10],d01=_CoarseHydrologyDepthTex[c01],d11=_CoarseHydrologyDepthTex[c11]; float4 mask=lerp(lerp(m00,m10,f.x),lerp(m01,m11,f.x),f.y); float4 depth=lerp(lerp(d00,d10,f.x),lerp(d01,d11,f.x),f.y); float flow=depth.b; float pxToCoarse=max(0.25,(float)_HydrologyAnalysisWidth/max(1.0,(float)_MapWidth)); float widthPx=lerp(_DrainageRiverMinWidthPixels,_DrainageRiverMaxWidthPixels,saturate(flow)); float widthCoarse=widthPx*pxToCoarse; float riverField=0; [unroll] for(int oy=-1;oy<=1;oy++) [unroll] for(int ox=-1;ox<=1;ox++){ int2 n=ClampAnalysis(base+int2(ox,oy)); float4 nm=_CoarseHydrologyMaskTex[n]; float4 nd=_CoarseHydrologyDepthTex[n]; float2 c=float2(n)+0.5; float d=length((float2(p)+0.5)/float2(_MapWidth,_MapHeight)*float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight)-c); float nWidth=max(0.35,widthCoarse*lerp(0.75,1.25,nd.b)); riverField=max(riverField,smoothstep(nWidth+0.75,nWidth-0.15,d)*nm.r); } float noise=hash1((uint)(p.x*92837111u+p.y*689287499u+asuint(_Seed*97.0))); float lakeOffset=(noise-0.5)*2.0*_LakeShorelineWarpPixels*pxToCoarse*0.15; float lakeSignal=mask.g+lakeOffset; float lake=saturate(smoothstep(0.50,0.65,lakeSignal)); float river=saturate(max(mask.r,riverField)); float wet=saturate(max(river,lake)*0.65 + depth.b*0.45); _GpuHydrologyTex[p]=float4(river,lake,wet,saturate(max(river,lake))); _GpuHydrologyDepthTex[p]=float4(river*depth.r,lake*depth.g,depth.b,depth.a);} 



[numthreads(8,8,1)]
void ClearExperimentalHydrology(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; _ExperimentalBasinCandidateTex[p]=0; _ExperimentalSelectedBasinTex[p]=0; _ExperimentalRiverPathTex[p]=0; _CoarseHydrologyMaskTex[p]=0; _CoarseHydrologyDepthTex[p]=0;}

[numthreads(8,8,1)]
void BuildExperimentalBasinCandidates(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float2 uv=(float2(p)+0.5)/float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight); int2 hp=int2(uv*float2(_MapWidth,_MapHeight)); float4 h=_GpuHeightTex.Load(int3(clampPix(hp),0)); float land=LoadLand(hp); float signedHeight=h.r; float basinPotential=h.a; float localLow=0; [unroll] for(int oy=-1;oy<=1;oy++) [unroll] for(int ox=-1;ox<=1;ox++){if(ox==0&&oy==0)continue; int2 np=ClampAnalysis(p+int2(ox,oy)); float2 nuv=(float2(np)+0.5)/float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight); int2 nhp=int2(nuv*float2(_MapWidth,_MapHeight)); float nH=_GpuHeightTex.Load(int3(clampPix(nhp),0)).r; localLow += saturate(nH-signedHeight);} localLow/=8.0; float inland=saturate(_TectonicSurfaceTex.Load(int3(clampPix(hp),0)).b); float score=(basinPotential*0.55+localLow*0.30+saturate(-signedHeight)*0.35+inland*0.15)*land; if(score<_ExperimentalMinBasinScore) score=0; _ExperimentalBasinCandidateTex[p]=float4(score,saturate(-signedHeight),basinPotential,inland);}
[numthreads(8,8,1)]
void SelectExperimentalBasins(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float4 c=_ExperimentalBasinCandidateTex[p]; float score=c.r; if(score<=_ExperimentalEffectiveMinBasinScore){_ExperimentalSelectedBasinTex[p]=0;return;} bool isMax=true; [unroll] for(int oy=-1;oy<=1;oy++) [unroll] for(int ox=-1;ox<=1;ox++){if(ox==0&&oy==0)continue; if(_ExperimentalBasinCandidateTex[ClampAnalysis(p+int2(ox,oy))].r>score){isMax=false;}} if(!isMax){_ExperimentalSelectedBasinTex[p]=0;return;} _ExperimentalSelectedBasinTex[p]=float4(1,score,c.g,1);}
[numthreads(8,8,1)]
void RasterizeExperimentalSelectedBasins(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float2 uv=(float2(p)+0.5)/float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight); int2 hp=int2(uv*float2(_MapWidth,_MapHeight)); float land=LoadLand(hp); float signedHeight=_GpuHeightTex.Load(int3(clampPix(hp),0)).r; float basinInfluence=0; const int radius=3; [unroll] for(int oy=-radius;oy<=radius;oy++) [unroll] for(int ox=-radius;ox<=radius;ox++){ int2 np=ClampAnalysis(p+int2(ox,oy)); float sel=_ExperimentalSelectedBasinTex[np].r; if(sel<=0) continue; float d=length(float2(ox,oy)); float falloff=saturate(1.0-d/(radius+0.5)); basinInfluence=max(basinInfluence,falloff*max(sel,_ExperimentalSelectedBasinTex[np].g)); } float lake=basinInfluence*smoothstep(0.02,0.18,-signedHeight)*land; float wet=lake*0.35; _CoarseHydrologyMaskTex[p]=float4(0,lake,wet,lake); _CoarseHydrologyDepthTex[p]=float4(0,lake*saturate(-signedHeight*3),_ExperimentalBasinCandidateTex[p].r,basinInfluence);}
[numthreads(8,8,1)]
void BuildExperimentalRiverPotential(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_HydrologyAnalysisWidth||p.y>=_HydrologyAnalysisHeight) return; float sel=_ExperimentalSelectedBasinTex[p].r; float valley=_ExperimentalBasinCandidateTex[p].r; float river=sel*0.45 + valley*0.25; river=saturate(river + (hash1((uint)(p.x*173u+p.y*941u))-0.5)*_ExperimentalRiverMeanderStrength*0.2); _ExperimentalRiverPathTex[p]=float4(river,0,0,1); float4 m=_CoarseHydrologyMaskTex[p]; m.r=max(m.r,river); m.b=saturate(m.b+river*0.35); m.a=max(m.a,m.r); _CoarseHydrologyMaskTex[p]=m; float4 depthOut = _CoarseHydrologyDepthTex[p]; depthOut.r=max(depthOut.r,river*0.4); _CoarseHydrologyDepthTex[p]=depthOut;}
[numthreads(8,8,1)]
void UpsampleExperimentalBasinHydrology(uint3 id:SV_DispatchThreadID){int2 p=id.xy; if(p.x>=_MapWidth||p.y>=_MapHeight) return; float2 uv=(float2(p)+0.5)/float2(_MapWidth,_MapHeight); int2 cp=ClampAnalysis(int2(uv*float2(_HydrologyAnalysisWidth,_HydrologyAnalysisHeight))); float4 coarse=_CoarseHydrologyMaskTex[cp]; float4 cDepth=_CoarseHydrologyDepthTex[cp]; float basinPot=_GpuHeightTex.Load(int3(p,0)).a; float wet=saturate((coarse.g*0.45+coarse.r*0.35+basinPot*0.25)*_ExperimentalWetlandSpread*lerp(0.5,1.8,_Moisture)); _GpuHydrologyTex[p]=float4(saturate(coarse.r),saturate(coarse.g),wet,saturate(max(coarse.r,coarse.g))); _GpuHydrologyDepthTex[p]=float4(cDepth.r,cDepth.g,saturate(coarse.r),saturate(coarse.g));}
