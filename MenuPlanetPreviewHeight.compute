#pragma kernel GenerateHeight

Texture2D<float4> _TectonicSurfaceTex;
Texture2D<float4> _TectonicCrustTex;
RWTexture2D<float4> _GpuHeightTex;

int _MapWidth;
int _MapHeight;
float _Seed;
float _Elevation;
float _ElevationNoiseStrength;
float _MacroReliefStrength;
float _MacroReliefScale;
float _InlandBasinStrength;
float _InlandBasinScale;
float _WatershedRidgeStrength;
int _UseExperimentalSignedTerrain;
int _TerrainRoughnessPresetIndex;
float _ExpHeightBias,_ExpUpwardReliefStrength,_ExpDownwardBasinStrength,_ExpValleyCutStrength;
float _ExpBroadNoiseAmplitude,_ExpMidNoiseAmplitude,_ExpFineNoiseAmplitude;
float _ExpBroadNoiseScale,_ExpMidNoiseScale,_ExpFineNoiseScale;
float _ExpRidgeStrength,_ExpHillThreshold,_ExpMountainThreshold,_ExpBasinCandidateBias;
static const float PI = 3.14159265359;
float Hash31(float3 p){p=frac(p*float3(0.1031,0.1030,0.0973));p+=dot(p,p.yxz+33.33);return frac((p.x+p.y)*p.z);} 
float Noise3D(float3 p){float3 i=floor(p),f=frac(p);f=f*f*(3.0-2.0*f);float n000=Hash31(i),n100=Hash31(i+float3(1,0,0)),n010=Hash31(i+float3(0,1,0)),n110=Hash31(i+float3(1,1,0)),n001=Hash31(i+float3(0,0,1)),n101=Hash31(i+float3(1,0,1)),n011=Hash31(i+float3(0,1,1)),n111=Hash31(i+float3(1,1,1));return lerp(lerp(lerp(n000,n100,f.x),lerp(n010,n110,f.x),f.y),lerp(lerp(n001,n101,f.x),lerp(n011,n111,f.x),f.y),f.z);} 
float Fbm(float3 p){float v=0,a=0.5,f=1;[unroll]for(int i=0;i<4;i++){v+=a*Noise3D(p*f);f*=2;a*=0.5;}return saturate(v);} 
float RidgedFbm(float3 p){float v=0,a=0.5,f=1;[unroll]for(int i=0;i<4;i++){float n=Noise3D(p*f);v+=a*(1-abs(n*2-1));f*=2;a*=0.5;}return saturate(v);} 
float CenteredFbm(float3 p){return Fbm(p)*2.0-1.0;}
[numthreads(8,8,1)]
void GenerateHeight(uint3 id:SV_DispatchThreadID){if(id.x>=(uint)_MapWidth||id.y>=(uint)_MapHeight)return;int2 pixel=int2(id.xy);float2 uv=(float2(pixel)+0.5)/float2(_MapWidth,_MapHeight);float lon=uv.x*2.0*PI-PI;float lat=(0.5-uv.y)*PI;float c=cos(lat);float3 objNorm=normalize(float3(c*cos(lon),sin(lat),c*sin(lon)));float landMask=_TectonicSurfaceTex.Load(int3(pixel,0)).r;float continentality=_TectonicCrustTex.Load(int3(pixel,0)).r;if(landMask<=0.001){_GpuHeightTex[pixel]=float4(0,0,0,1);return;}float3 seedOffsetA=_Seed*float3(0.103,0.071,0.137)+float3(13.7,41.2,5.9),seedOffsetB=_Seed*float3(0.067,0.149,0.091)+float3(59.1,11.6,83.4),seedOffsetC=_Seed*float3(0.173,0.113,0.047)+float3(27.8,73.5,19.2);
if(_UseExperimentalSignedTerrain>0){float broad=CenteredFbm(objNorm*max(0.15,_ExpBroadNoiseScale)+seedOffsetA),mid=CenteredFbm(objNorm*max(0.2,_ExpMidNoiseScale)+seedOffsetB),fine=CenteredFbm(objNorm*max(0.25,_ExpFineNoiseScale)+seedOffsetC);float ridge=RidgedFbm(objNorm*(max(0.2,_ExpMidNoiseScale)*1.35)+seedOffsetA*0.35);float basinRaw=Fbm(objNorm*max(0.15,_ExpBroadNoiseScale*0.75)+seedOffsetB*0.21);float basinField=pow(saturate(1.0-basinRaw),2.0);float valleyField=pow(saturate(1.0-RidgedFbm(objNorm*(max(0.2,_ExpMidNoiseScale)*0.85)+seedOffsetC*0.27)),1.5);float upwardRelief=max(0,broad)*_ExpBroadNoiseAmplitude+max(0,mid)*_ExpMidNoiseAmplitude+max(0,fine)*_ExpFineNoiseAmplitude*0.35+ridge*_ExpRidgeStrength;float downwardRelief=basinField*_ExpDownwardBasinStrength+valleyField*_ExpValleyCutStrength+max(0,-broad)*_ExpBroadNoiseAmplitude*0.65+max(0,-mid)*_ExpMidNoiseAmplitude*0.35;float signedHeight=(_ExpHeightBias+upwardRelief-downwardRelief)*landMask;float hillMask=landMask*smoothstep(_ExpHillThreshold,_ExpHillThreshold+0.18,signedHeight);float mountainMask=landMask*smoothstep(_ExpMountainThreshold,_ExpMountainThreshold+0.16,signedHeight+ridge*0.25);float basinPotential=landMask*smoothstep(0.02,0.22,-signedHeight)*_ExpBasinCandidateBias;basinPotential*=smoothstep(0.10,0.35,basinField);_GpuHeightTex[pixel]=float4(signedHeight,saturate(hillMask),saturate(mountainMask),saturate(basinPotential));return;}
float elevationNoise=lerp(0.55,1.45,saturate(_ElevationNoiseStrength));float hillNoise=Fbm(objNorm*(1.35*elevationNoise)+seedOffsetA),mountainProvinceNoise=Fbm(objNorm*(1.85*elevationNoise)+seedOffsetB),mountainRangeNoise=RidgedFbm(objNorm*(3.5*elevationNoise)+seedOffsetC),macroReliefNoise=Fbm(objNorm*max(0.2,_MacroReliefScale)+seedOffsetA*0.25),basinNoise=1.0-Fbm(objNorm*max(0.2,_InlandBasinScale)+seedOffsetB*0.21),watershedRidge=RidgedFbm(objNorm*2.2+seedOffsetC*0.35);float roughness=saturate(_Elevation),hillThreshold=lerp(0.76,0.30,roughness),mountainThreshold=lerp(0.96,0.62,roughness),foothillThreshold=lerp(0.83,0.46,roughness);float hillMask=landMask*smoothstep(hillThreshold,hillThreshold+0.12,hillNoise);float mountainCandidate=saturate(mountainProvinceNoise*0.55+mountainRangeNoise*0.45);float mountainMask=landMask*smoothstep(mountainThreshold,mountainThreshold+0.10,mountainCandidate);float foothillMask=landMask*smoothstep(foothillThreshold,foothillThreshold+0.14,mountainCandidate)*(1.0-mountainMask);float usableHillMask=hillMask*(1.0-mountainMask*0.45),interiorBoost=lerp(0.85,1.10,saturate(continentality));float baseLandHeight=landMask*0.075;float rollingReliefNoise=(hillNoise-0.5)*2.0,rollingRelief=rollingReliefNoise*lerp(0.0,0.09,roughness)*landMask*interiorBoost;float broadRelief=(Fbm(objNorm*(0.85*elevationNoise)+seedOffsetB*0.41)-0.5)*2.0,midRelief=(Fbm(objNorm*(2.20*elevationNoise)+seedOffsetA*0.73)-0.5)*2.0,terrainVariance=(broadRelief*lerp(0.010,0.085,roughness)+midRelief*lerp(0.004,0.045,roughness))*landMask*interiorBoost;float hillHeight=usableHillMask*lerp(0.025,0.12,roughness)*interiorBoost,foothillHeight=foothillMask*lerp(0.015,0.09,roughness)*interiorBoost,mountainHeight=mountainMask*lerp(0.06,0.28,roughness)*interiorBoost;float centeredMacroNoise=(macroReliefNoise-0.5)*2.0,macroRelief=centeredMacroNoise*_MacroReliefStrength*landMask;float inlandPreference=saturate(continentality*smoothstep(0.15,0.7,landMask));float midElevationPreference=1.0-smoothstep(0.45,0.95,baseLandHeight+hillHeight+mountainHeight);float basinPotential=saturate(basinNoise*inlandPreference*midElevationPreference);basinPotential*=(1.0-saturate(abs(rollingReliefNoise)*lerp(0.15,0.55,roughness)));float basinCarve=basinPotential*_InlandBasinStrength,ridgeLift=(watershedRidge-0.5)*2.0*_WatershedRidgeStrength*inlandPreference,finalHeight=saturate(baseLandHeight+terrainVariance+hillHeight+foothillHeight+mountainHeight+macroRelief+ridgeLift-basinCarve);_GpuHeightTex[pixel]=float4(finalHeight,saturate(hillMask+foothillMask*0.75),mountainMask,saturate((rollingRelief+0.12)/0.24));
}
