#pragma kernel BakeTextures

// Input buffers
StructuredBuffer<int> _PixelToTileLUT;          // Pixel index -> tile index
StructuredBuffer<int> _TileBiomeIndices;         // Tile index -> biome enum value
StructuredBuffer<float2> _TileUVs;              // Tile index -> UV coordinates (0-1)
StructuredBuffer<float> _TileElevations;        // Tile index -> elevation (0-1)

// Biome color lookup table.
// Index in buffer = Biome enum value, value = RGBA color.
StructuredBuffer<float4> _BiomeColorLookup;

// Output textures
RWTexture2D<float4> _BiomeTexture;              // RGBA32 biome texture
RWTexture2D<float> _HeightTexture;              // RFloat heightmap texture

// Parameters
int _Width;
int _Height;
int _TileCount;
int _MaxBiomeValue;

[numthreads(8,8,1)]
void BakeTextures (uint3 id : SV_DispatchThreadID)
{
    // Bounds check
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    
    // Calculate pixel index (row-major order)
    int pixelIndex = (int)(id.y * _Width + id.x);
    
    // Lookup tile index from LUT
    int tileIndex = _PixelToTileLUT[pixelIndex];
    
    // Clamp tile index to valid range
    if (tileIndex < 0 || tileIndex >= _TileCount)
        tileIndex = 0;
    
    // Get biome index and UV for this tile
    int biomeIndex = _TileBiomeIndices[tileIndex];
    float2 uv = _TileUVs[tileIndex];
    
    // Normalize UVs defensively (repeat U, clamp V)
    uv.x = frac(uv.x);
    uv.y = saturate(uv.y);
    
    // Clamp biome index
    if (biomeIndex < 0 || biomeIndex >= _MaxBiomeValue)
        biomeIndex = 0;
    
    // Look up biome color.
    // Note: StructuredBuffers can't be NULL-checked in HLSL, so we rely on bounds checking.
    float4 biomeColor = float4(1.0, 0.0, 1.0, 1.0); // Default: magenta (error color)
    if (biomeIndex >= 0 && biomeIndex < _MaxBiomeValue)
    {
        biomeColor = _BiomeColorLookup[biomeIndex];
    }
    
    // Sample elevation
    float elevation = _TileElevations[tileIndex];
    elevation = clamp(elevation, 0.0, 1.0);
    
    // Write to output textures
    _BiomeTexture[int2(id.x, id.y)] = biomeColor;
    _HeightTexture[int2(id.x, id.y)] = elevation;
}

