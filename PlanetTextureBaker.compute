#pragma kernel BakeTextures

// Input buffers
StructuredBuffer<int> _PixelToTileLUT;          // Pixel index -> tile index
StructuredBuffer<int> _TileBiomeIndices;         // Tile index -> biome enum value
StructuredBuffer<float2> _TileUVs;              // Tile index -> UV coordinates (0-1)
StructuredBuffer<float> _TileElevations;        // Tile index -> elevation (0-1)

// Optional buffers (depending on render mode)
StructuredBuffer<float4> _BiomeColorLookup;     // Biome enum value -> RGBA color (BiomeColors mode)
StructuredBuffer<int> _BiomeToTextureIndex;    // Biome enum value -> texture array index (-1 = no texture)
StructuredBuffer<float4> _TileBiomeColors;      // Tile index -> RGBA color (fallback)

// Texture resources (depending on render mode)
Texture2DArray<float4> _BiomeTextureArray;      // Array of biome textures (BiomeTextures mode)
SamplerState sampler_BiomeTextureArray;
Texture2D<float4> _CustomTexture;                // Single custom texture (CustomTexture mode)
SamplerState sampler_CustomTexture;

// Output textures
RWTexture2D<float4> _BiomeTexture;              // RGBA32 biome texture
RWTexture2D<float> _HeightTexture;              // RFloat heightmap texture

// Parameters
int _Width;
int _Height;
int _TileCount;
int _MaxBiomeValue;
int _RenderMode;  // 0 = BiomeColors, 1 = BiomeTextures, 2 = CustomTexture
int _BiomeTextureArraySize;  // Size of texture array (number of textures)

[numthreads(8,8,1)]
void BakeTextures (uint3 id : SV_DispatchThreadID)
{
    // Bounds check
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    
    // Calculate pixel index (row-major order)
    int pixelIndex = (int)(id.y * _Width + id.x);
    
    // Lookup tile index from LUT
    int tileIndex = _PixelToTileLUT[pixelIndex];
    
    // Clamp tile index to valid range
    if (tileIndex < 0 || tileIndex >= _TileCount)
        tileIndex = 0;
    
    // Get biome index and UV for this tile
    int biomeIndex = _TileBiomeIndices[tileIndex];
    float2 uv = _TileUVs[tileIndex];
    
    // Normalize UVs defensively (repeat U, clamp V)
    uv.x = frac(uv.x);
    uv.y = saturate(uv.y);
    
    // Clamp biome index
    if (biomeIndex < 0 || biomeIndex >= _MaxBiomeValue)
        biomeIndex = 0;
    
    // Sample biome color based on render mode
    float4 biomeColor = float4(1.0, 0.0, 1.0, 1.0); // Default: magenta (error color)
    
    if (_RenderMode == 0) // BiomeColors mode
    {
        // Look up color from biome color lookup table
        // Note: StructuredBuffers can't be NULL-checked in HLSL, so we rely on bounds checking
        if (biomeIndex >= 0 && biomeIndex < _MaxBiomeValue)
        {
            biomeColor = _BiomeColorLookup[biomeIndex];
        }
        else
        {
            // Fallback to magenta if lookup fails
            biomeColor = float4(1.0, 0.0, 1.0, 1.0);
        }
    }
    else if (_RenderMode == 1) // BiomeTextures mode
    {
        // Sample from texture array using biome-to-texture-index mapping
        // Note: We can't NULL-check StructuredBuffers or Texture2DArray in HLSL
        // We rely on _BiomeTextureArraySize > 0 to indicate array is available
        
        if (_BiomeTextureArraySize > 0 && biomeIndex >= 0 && biomeIndex < _MaxBiomeValue)
        {
            // Look up texture array index for this biome
            int textureArrayIndex = _BiomeToTextureIndex[biomeIndex];
            
            if (textureArrayIndex >= 0 && textureArrayIndex < _BiomeTextureArraySize)
            {
                // Sample from texture array at the mapped index
                // HLSL constructor expects float, so cast slice index explicitly (DX11 is stricter here).
                biomeColor = _BiomeTextureArray.SampleLevel(sampler_BiomeTextureArray, float3(uv, (float)textureArrayIndex), 0);
            }
            else
            {
                // Biome has no texture assigned, fallback to pre-computed color
                biomeColor = _TileBiomeColors[tileIndex];
            }
        }
        else
        {
            // Fallback to pre-computed colors if texture array unavailable
            biomeColor = _TileBiomeColors[tileIndex];
        }
    }
    else if (_RenderMode == 2) // CustomTexture mode
    {
        // Sample from single custom texture using UV
        // Note: We can't NULL-check Texture2D in HLSL, so we always try to sample
        // If texture isn't set, this will return black/transparent
        biomeColor = _CustomTexture.SampleLevel(sampler_CustomTexture, uv, 0);
    }
    
    // Sample elevation
    float elevation = _TileElevations[tileIndex];
    elevation = clamp(elevation, 0.0, 1.0);
    
    // Write to output textures
    _BiomeTexture[int2(id.x, id.y)] = biomeColor;
    _HeightTexture[int2(id.x, id.y)] = elevation;
}

